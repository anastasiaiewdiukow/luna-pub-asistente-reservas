    {
      "parameters": {
        "jsCode": "// Leemos los datos enviados al inicio del workflow.\nconst entrada = $('Recibir accion y datos del agente').first().json;\nconst datos = { ...entrada };\nconst errores = [];\n\n// Quitamos espacios y comprobamos los campos de texto.\nconst campos = [\n  'session_id',\n  'nombre',\n  'contacto',\n  'check_in',\n  'check_out',\n  'tipo_habitacion'\n];\n\nfor (const campo of campos) {\n  datos[campo] = typeof datos[campo] === 'string'\n    ? datos[campo].trim()\n    : '';\n\n  if (!datos[campo]) {\n    errores.push(`Falta completar: ${campo}`);\n  }\n}\n\n// Comprobamos que las fechas existan y tengan formato YYYY-MM-DD.\nfunction fechaValida(texto) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(texto)) return false;\n\n  const fecha = new Date(`${texto}T00:00:00Z`);\n\n  return !Number.isNaN(fecha.getTime())\n    && fecha.toISOString().slice(0, 10) === texto;\n}\n\n// Calculamos la fecha actual en Uruguay.\nconst partes = new Intl.DateTimeFormat('en-US', {\n  timeZone: 'America/Montevideo',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit'\n}).formatToParts(new Date());\n\nconst parte = tipo => partes.find(p => p.type === tipo).value;\nconst hoy = `${parte('year')}-${parte('month')}-${parte('day')}`;\n\nconst entradaValida = fechaValida(datos.check_in);\nconst salidaValida = fechaValida(datos.check_out);\n\nif (!entradaValida) {\n  errores.push('La fecha de entrada no es válida.');\n}\n\nif (!salidaValida) {\n  errores.push('La fecha de salida no es válida.');\n}\n\nif (entradaValida && datos.check_in < hoy) {\n  errores.push('La fecha de entrada no puede estar en el pasado.');\n}\n\nif (entradaValida && salidaValida\n    && datos.check_out <= datos.check_in) {\n  errores.push('La salida debe ser posterior a la entrada.');\n}\n\n// La cantidad debe ser un número entero positivo.\nif (!Number.isInteger(datos.cantidad_personas)\n    || datos.cantidad_personas <= 0) {\n  errores.push('La cantidad de personas debe ser un entero positivo.');\n}\n\n// Solo admitimos los tipos de habitación definidos.\ndatos.tipo_habitacion = datos.tipo_habitacion.toLowerCase();\n\nif (!['privada', 'compartida'].includes(datos.tipo_habitacion)) {\n  errores.push('El tipo de habitación debe ser privada o compartida.');\n}\n\n// Revisamos la confirmación informada por el agente.\nif (datos.resumen_confirmado !== true) {\n  errores.push('Falta la confirmación del resumen.');\n}\n\n// Devolvemos los datos y el resultado de la revisión.\nreturn [{\n  json: {\n    ...datos,\n    solicitud_valida: errores.length === 0,\n    errores\n  }\n}];"
      },
