    {
      "parameters": {
        "jsCode": "// Datos nuevos enviados por el agente.\nconst nuevos = $('Recibir accion y datos del agente').first().json;\n\n// Datos encontrados en Google Sheets, o un objeto vacío.\nconst anteriores = $('Consultar solicitud actual').first().json;\n\nconst datos = { ...anteriores };\n\n// Incorporamos únicamente los campos de la solicitud.\nconst campos = [\n  'nombre',\n  'contacto',\n  'check_in',\n  'check_out',\n  'cantidad_personas',\n  'tipo_habitacion',\n  'comentarios_extra'\n];\n\nfor (const campo of campos) {\n  const valor = nuevos[campo];\n\n  // No reemplazamos información anterior con valores vacíos.\n  if (valor === undefined || valor === null) continue;\n  if (typeof valor === 'string' && valor.trim() === '') continue;\n\n  datos[campo] = typeof valor === 'string'\n    ? valor.trim()\n    : valor;\n}\n\n// Conservamos el identificador de la conversación.\ndatos.session_id = nuevos.session_id;\n\n// Si ya tiene un código y una fecha, los conservamos.\ndatos.id_solicitud = anteriores.id_solicitud\n  || 'SOL-' + datos.session_id;\n\ndatos.fecha_registro = anteriores.fecha_registro\n  || $now.toISO();\n\n// Un avance nuevo queda en curso.\n// Si ya existía otro estado, lo conservamos.\ndatos.estado = anteriores.estado || 'en_curso';\n\nreturn [{ json: datos }];"
      },
