    {
      "parameters": {
        "jsCode": "// Datos nuevos enviados por el agente.\nconst nuevos = $('Recibir accion y datos del agente').first().json;\n\n// Datos encontrados en Google Sheets.\nconst anteriores = $('Consultar solicitud actual').first().json;\n\nconst datos = { ...anteriores };\n\n// Incorporamos los datos nuevos sin borrar los anteriores\n// cuando llega un campo vacío.\nconst campos = [\n  'nombre',\n  'contacto',\n  'check_in',\n  'check_out',\n  'cantidad_personas',\n  'tipo_habitacion',\n  'comentarios_extra'\n];\n\nfor (const campo of campos) {\n  const valor = nuevos[campo];\n\n  if (valor === undefined || valor === null) continue;\n  if (typeof valor === 'string' && valor.trim() === '') continue;\n\n  datos[campo] = typeof valor === 'string'\n    ? valor.trim()\n    : valor;\n}\n\n// Identificamos la conversación y la solicitud.\ndatos.session_id = nuevos.session_id;\n\ndatos.id_solicitud = anteriores.id_solicitud\n  || 'SOL-' + datos.session_id;\n\ndatos.fecha_registro = anteriores.fecha_registro\n  || $now.toISO();\n\n// Marcamos el caso para atención humana.\ndatos.estado = 'requiere_atencion_humana';\n\nreturn [{ json: datos }];"
      },
